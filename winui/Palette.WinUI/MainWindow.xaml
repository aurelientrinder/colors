<Window
    x:Class="Palette.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Palette"
    Title="PaletteWinUI">

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootXf" />
        </Grid.RenderTransform>

        <!-- The window is wide enough for the list plus a preview; Stage is the visible panel. It is
             centred and list-wide, and widens on both sides when a file is selected. -->
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- Glass: light catching the upper part of the pane (the rim is drawn by ShadowWindow). -->
                    <ResourceDictionary x:Key="Dark">
                        <LinearGradientBrush x:Key="SheenBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,180">
                            <GradientStop Offset="0" Color="#12FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <LinearGradientBrush x:Key="SheenBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,180">
                            <GradientStop Offset="0" Color="#59FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid
            x:Name="Stage"
            Width="680"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">

        <!-- bottom-anchored: key hints, results (best match last), divider, search field -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="4"
            Background="{ThemeResource SheenBrush}"
            IsHitTestVisible="False" />

        <!-- search field -->
        <Grid Grid.Row="3" Padding="22,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE721;" />

            <TextBox
                x:Name="Input"
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Segoe UI Variable Display, Segoe UI"
                FontSize="22"
                FontWeight="SemiLight"
                PlaceholderText="Search apps, files, settings…"
                PreviewKeyDown="OnInputKeyDown"
                TextChanged="OnInputChanged">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <Border
            x:Name="Divider"
            Grid.Row="2"
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="Collapsed" />

        <!-- results, with the preview opening inline under the selected row -->
        <Grid x:Name="Body" Grid.Row="1" Height="0">

        <!-- The list is flipped (and each row flipped back) so the best match sits next to the
             search field and the rest stack upward from it. -->
        <ListView
            x:Name="ResultsList"
            Margin="8,6,8,6"
            VerticalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            RightTapped="OnRowRightTapped"
            ItemsSource="{x:Bind Items}"
            SelectionChanged="OnSelectionChanged"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionMode="Single">
            <!-- Rows arriving later (Related) must not slide or fade in: the built-in item
                 transitions animate them from the wrong side of the flipped list. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.RenderTransform>
                <ScaleTransform ScaleY="-1" />
            </ListView.RenderTransform>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="52" />
                    <Setter Property="Padding" Value="16,0,12,0" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HitVm">
                    <Grid Height="52" ColumnSpacing="14" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleY="-1" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="32"
                            Height="32"
                            Source="{x:Bind Icon, Mode=OneWay}"
                            Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                        <Border
                            Width="32"
                            Height="32"
                            Background="{x:Bind TileBrush, Mode=OneWay}"
                            CornerRadius="8"
                            Visibility="{x:Bind TileVisibility, Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="White"
                                Glyph="{x:Bind Glyph, Mode=OneWay}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                TextTrimming="CharacterEllipsis"
                                local:Hl.Rev="{x:Bind Rev, Mode=OneWay}"
                                local:Hl.Vm="{x:Bind}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Padding="7,2,7,3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="5"
                            Visibility="{x:Bind ChipVisibility, Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Kind, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            x:Name="PreviewPane"
            Height="224"
            Margin="14,0,14,0"
            VerticalAlignment="Bottom"
            Opacity="0"
            Visibility="Collapsed">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    DoubleTapped="OnPreviewDoubleTapped">
                    <Grid>
                        <Image
                            x:Name="PreviewIcon"
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Image
                            x:Name="PreviewImage"
                            Margin="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <ScrollViewer
                            x:Name="PreviewScroll"
                            AllowFocusOnInteraction="False"
                            HorizontalScrollBarVisibility="Auto"
                            IsTabStop="False"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PreviewText"
                                Padding="14,12,14,12"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="18" />
                        </ScrollViewer>
                        <TextBlock
                            x:Name="PreviewNote"
                            Margin="16,0,16,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- the row above already shows the name and folder -->
                <TextBlock
                    x:Name="PreviewMeta"
                    Grid.Row="1"
                    Margin="4,0,4,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        </Grid>

        <!-- key hints -->
        <Border
            x:Name="Footer"
            Grid.Row="0"
            Height="36"
            Padding="18,0"
            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Padding="6,1,6,2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Enter" />
                    </Border>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Open" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Padding="6,1,6,2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl+Enter" />
                    </Border>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Reveal" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Padding="6,1,6,2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Tab" />
                    </Border>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Actions" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Padding="6,1,6,2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Esc" />
                    </Border>
                    <TextBlock x:Name="FooterEsc" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Close" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="FooterStatus"
                Grid.Column="1"
                Margin="16,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        </Grid>
    </Grid>
</Window>
