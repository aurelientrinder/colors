<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Palette</RootNamespace>
    <AssemblyName>PaletteWinUI</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The installed copy (scripts\install-uiaccess.ps1): an optimised build with UI Access, in
         bin\x64\Install so it never replaces the Debug or Release builds, which must stay without it. -->
    <Configurations>Debug;Release;Install</Configurations>
    <Optimize Condition="'$(Configuration)' == 'Install'">true</Optimize>
    <ApplicationManifest Condition="'$(Configuration)' == 'Install'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\palette.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

  <!-- Tray icon is loaded from this file at runtime (the exe icon is embedded via ApplicationIcon). -->
  <ItemGroup>
    <None Include="Assets\palette.ico" Link="palette.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Rust engine and admin helper, built by cargo (release profile) at the repo root. -->
  <ItemGroup>
    <None Include="..\..\target\release\palette_core.dll" Link="palette_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\target\release\palette-mft.exe" Link="palette-mft.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\target\release\palette-semantic.exe" Link="palette-semantic.exe" CopyToOutputDirectory="PreserveNewest" />
    <!-- The plan model on the NPU (needs models\openvino and models\planner-npu; see scripts\get-openvino.ps1). -->
    <None Include="..\..\target\release\palette-plan.exe" Link="palette-plan.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\target\release\palette-plan.exe')" />
    <!-- DirectML runtime for palette-semantic's GPU path (placed next to it by ort's build). -->
    <None Include="..\..\target\release\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\target\release\DirectML.dll')" />
  </ItemGroup>

  <!-- Embedding model for the semantic tier (fetched by scripts\get-model.ps1). Optional: without it
       the launcher simply has no "Related" results. -->
  <ItemGroup>
    <None Include="..\..\models\**\*.*" Exclude="..\..\models\**\.download-done" Link="models\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
