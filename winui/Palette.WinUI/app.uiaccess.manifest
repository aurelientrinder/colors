<?xml version="1.0" encoding="utf-8"?>
<!-- app.manifest plus UI Access, for the installed copy only (the Install configuration, see
     scripts\install-uiaccess.ps1).
     UI Access lets the palette's keyboard hook see keys typed into elevated windows, so the
     Windows key opens it over Task Manager too, while it stays an ordinary unelevated app.
     Windows starts a UI Access exe only when it is signed by a trusted certificate and sits in
     a secure folder (Program Files): this manifest on a bin\ build would stop it starting. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PaletteWinUI.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="true" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
